# ---------------------------------------------------------------------------
# Copy to .env and adjust. Never commit the real .env file.
# ---------------------------------------------------------------------------

# development | production
ENVIRONMENT=development

# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Leave unset to fall back to sqlite:///./preptrack.db
# Local Docker Compose value:
DATABASE_URL=postgresql://preptrack:preptrack@localhost:5432/preptrack
# Render + Neon (use the *pooled* connection string, note sslmode=require):
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 1 to log every SQL statement (verbose; keep 0 in production)
SQL_ECHO=0

# Credentials created by seed.py
SEED_USER_EMAIL=demo@preptrack.dev
SEED_USER_PASSWORD=DemoPass123!
